OSS_ENDPOINT=xxx
OSS_ACCESS_KEY=xxx
OSS_SECRET_KEY=xxx
OSS_BUCKET_NAME=perception-mining
OSS_PUBLIC_BASE_URL=/media

SERVER_HOST=localhost
SERVER_PORT=30012

DASHSCOPE_API_KEY=xxx
MODEL_NAME=qwen-vl-max-latest

DB_NAME=video_db

VIDEO_FRAME_INTERVAL=30    # 视频抽帧间隔（每N帧抽取一帧）
VIDEO_FRAME_BATCH_SIZE=50  # 向量批量插入大小

# 场景挖掘算法配置
SCENE_MINING_CONFIG_PATH=app/algorithm/scene_mining/config-qwen-gemini.yaml
SCENE_MINING_OUTPUT_DIR=outputs/scene_mining
SCENE_MINING_VIDEO_CACHE_DIR=data/scene_mining_videos
SCENE_MINING_VIDEO_URL_PREFIX=file:///app/videos
SCENE_MINING_MEDIA_BASE_URL=http://127.0.0.1:30012
SCENE_MINING_MEDIA_SIGN_SECRET=change-me
SCENE_MINING_MEDIA_URL_TTL_SECONDS=7200
SCENE_MINING_SUMMARY_MAX_TOKENS=4096

# 模型服务统一走外部 one-api；本项目不启动 VLM/Embedding 大模型。
ONE_API_KEY=xxx
SCENE_MINING_API_BASE_URL=http://127.0.0.1:30049/v1
SCENE_MINING_API_MODEL_NAME=Qwen3-VL-32B-Instruct

# Qwen3-VL-Embedding 检索配置
EMBEDDING_MODEL=qwen3-vl
QWEN3_VL_EMBEDDING_BASE_URL=http://127.0.0.1:30049/v1
QWEN3_VL_EMBEDDING_MODEL_NAME=Qwen3-VL-Embedding-8B
QWEN3_VL_EMBEDDING_DIM=4096
QWEN3_VL_EMBEDDING_TIMEOUT=300
QWEN3_VL_EMBEDDING_RETRIES=2
QWEN3_VL_EMBEDDING_RETRY_BACKOFF=1
MILVUS_VIDEO_COLLECTION_NAME=video_vector_qwen3vl8b_4096
MILVUS_VIDEO_FRAME_COLLECTION_NAME=video_frame_vector_qwen3vl8b_4096
MILVUS_VIDEO_TEXT_FEATURE_COLLECTION_NAME=video_text_features_qwen3vl8b_4096
MILVUS_VIDEO_VISUAL_FEATURE_COLLECTION_NAME=video_visual_features_qwen3vl8b_4096
FRAME_SAMPLE_FPS=1
FRAME_SAMPLE_MAX_FRAMES=20
FRAME_SAMPLE_EVENT_FPS=1
FRAME_SAMPLE_EVENT_WEIGHT=1.5
RAWDATA_REQUEST_TIMEOUT=3
MEDIA_CACHE_DIR=data/media_cache
MEDIA_CACHE_MAX_AGE=3600
TASK_STATUS_DIR=data/task_status
UPLOAD_LOCK_DIR=/tmp/vision_perception_locks
ENABLE_LEGACY_VIDEO_PROXY=false

# 直接 URL 挖掘接口签名配置：
# body_hash = SHA256(raw_body)
# sign = HmacSHA256(method + "\n" + path + "\n" + timestamp + "\n" + nonce + "\n" + body_hash, DIRECT_MINING_SIGN_SECRET)
DIRECT_MINING_SIGN_SECRET=change-me
DIRECT_MINING_SIGN_WINDOW_SECONDS=300
